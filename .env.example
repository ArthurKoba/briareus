# Local / non-Coolify application override template.
# Production application runtimes are configured as independent Coolify Applications.

# Machine/runtime compatibility.
TZ=UTC
LANG=C.UTF-8
LC_ALL=C.UTF-8
# DRM render node exposed only to the Web Chromium container.
BROWSER_DRI_DEVICE=/dev/dri/renderD128

# Public gateway / local OAuth.
OAUTH_ENABLED=true
MCP_PUBLIC_BASE_URL=https://mcp.example.com
AUTHORIZATION_POSTGRES_HOST=postgres
AUTHORIZATION_POSTGRES_PORT=5432
AUTHORIZATION_POSTGRES_DB=authorization
AUTHORIZATION_POSTGRES_USER=
AUTHORIZATION_POSTGRES_PASSWORD=
AUTHORIZATION_BOOTSTRAP_USERNAME=
AUTHORIZATION_BOOTSTRAP_PASSWORD=
AUTHORIZATION_JWT_PRIVATE_KEY_PEM=
AUTHORIZATION_JWT_PUBLIC_KEY_PEM=
AUTHORIZATION_JWT_KEY_ID=authorization-1
AUTHORIZATION_ACCESS_TOKEN_TTL_SECONDS=900
AUTHORIZATION_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTHORIZATION_ALLOWED_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
AUTHORIZATION_GATEWAY_SERVICE_TOKEN=
AUTHORIZATION_ADMIN_SERVICE_TOKEN=
AUTHORIZATION_SERVICE_URL=http://authorization:8000
AUTHORIZATION_ACCESS_ENABLED=false
AUTHORIZATION_ACCESS_URL=http://authorization:8000/internal/access
AUTHORIZATION_ACCESS_TIMEOUT_SECONDS=2
AUTHORIZATION_SESSION_DEFAULT_TTL_SECONDS=3600
AUTHORIZATION_SESSION_CACHE_TTL_SECONDS=300
AUTHORIZATION_INVALID_SESSION_SOFT_LIMIT=5
AUTHORIZATION_INVALID_SESSION_OAUTH_REVOKE_LIMIT=50
AUTHORIZATION_INVALID_SESSION_WINDOW_SECONDS=600
AUTHORIZATION_INVALID_SESSION_BACKOFF_SECONDS=30

# Generated automatically by Coolify for fresh resources; set explicitly for
# local Compose and preserve existing values when migrating persistent state.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mcp-bridge
POSTGRES_USER=
POSTGRES_PASSWORD=
ADMIN_API_ENCRYPTION_KEY=
ADMIN_API_SERVICE_TOKEN=
ADMIN_API_USERNAME=admin
ADMIN_API_PASSWORD=
ADMIN_API_SESSION_SECRET=
ADMIN_UI_ORIGIN=https://admin.mcp.example.com

# Shared infrastructure locations. Compose DNS defaults are production-safe;
# override only for split-machine/dev topologies.
VALKEY_URL=redis://valkey:6379/0
ADMIN_API_URL=http://admin-api:8000
GITHUB_URL=http://github:8000/mcp
GITLAB_URL=http://gitlab:8000/mcp
FILES_URL=http://files:8000/mcp
WEB_URL=http://web:8000/mcp
ANALYSIS_URL=http://analysis:8000/mcp
GHIDRA_URL=http://ghidra:8000/mcp
TERMINAL_URL=http://terminal:8000/mcp
OBSERVABILITY_URL=http://observability:8000/mcp
GHIDRA_MCP_URL=http://bridge:8081/mcp

# Shared observability contract. Empty OTLP_ENDPOINT disables exporters.
OTLP_ENDPOINT=
OTLP_BEARER_TOKEN=
SERVICE_NAMESPACE=MCP
DEPLOYMENT_ENVIRONMENT=development
OTEL_SERVICE_NAME=mcp-bridge
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_TIMEOUT=10000
OTEL_METRIC_EXPORT_INTERVAL=30000
OTEL_LOG_LEVEL=INFO

# Terminal containment / locale overrides.
TERMINAL_MEMORY_LIMIT=2g
TERMINAL_MEMORY_SWAP_LIMIT=2g
TERMINAL_CPU_LIMIT=1.5
TERMINAL_PIDS_LIMIT=256
TERMINAL_LANG=C.UTF-8
