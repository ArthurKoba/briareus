{
  "schema": "briareus-domain-databases-v2",
  "physical_postgres_dns": "briareus-postgres",
  "network": "briareus-net",
  "legacy_database_do_not_migrate": "briareus_dev",
  "provisioning_status": "automatic_on_data_start_pending_live_observation",
  "initial": [
    {
      "owner": "access",
      "module": "authorization",
      "database": "briareus_access",
      "role_env": "POSTGRES_USER",
      "secret_env": "POSTGRES_PASSWORD"
    },
    {
      "owner": "platform",
      "module": "platform",
      "database": "briareus_platform",
      "role_env": "POSTGRES_USER",
      "secret_env": "POSTGRES_PASSWORD"
    },
    {
      "owner": "resources",
      "module": "resources",
      "database": "briareus_resources",
      "role_env": "POSTGRES_USER",
      "secret_env": "POSTGRES_PASSWORD"
    },
    {
      "owner": "rauthy",
      "module": "external",
      "database": "briareus_rauthy",
      "role_env": "POSTGRES_USER",
      "secret_env": "POSTGRES_PASSWORD"
    }
  ],
  "deferred_until_feature_activation": [
    {
      "owner": "files",
      "database": "briareus_files"
    },
    {
      "owner": "runtime",
      "database": "briareus_runtime"
    },
    {
      "owner": "reverse",
      "database": "briareus_reverse"
    }
  ],
  "immutable_guards": {
    "no_live_creation_approved": false,
    "no_global_authorization_migrator": true,
    "no_manual_one_shot_schema_init": true,
    "no_existing_volume_or_network_mutation": true,
    "no_public_C2_until_trust_review": true,
    "no_bulk_MCP_events_in_oltp": true
  },
  "role_model": "shared_existing_postgres_principal_four_active_logical_databases",
  "excluded_legacy_databases_do_not_touch_automatically": [
    "briareus_identity",
    "briareus_dev"
  ],
  "protected_provider_databases": [
    "briareus_rauthy"
  ]
}
